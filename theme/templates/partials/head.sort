
<head>
  <meta charset="{ meta.charset }">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="format-detection" content="telephone=no">
  <meta name="generator" content="hadley" />
  <meta name="google" content="notranslate">
  <meta name="theme-color" content="#1a1a19">

  <script src="{ assets['/assets/js/darkmode.js'] }"></script>
  <script src="{ assets['/assets/js/nav.js'] }" defer></script>
  <script src="{ assets['/assets/js/hero-demo.js'] }" defer></script>
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/source-serif-4-var.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/plex-sans-var.woff2" crossorigin />
  <link rel="stylesheet" type="text/css" href="{ assets['/assets/css/style.css'] }" />
  <link rel="stylesheet" type="text/css" href="{ assets['/assets/css/syntax-highlighting.css'] }" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="128x128" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <title>{ htmlTitle }</title>

  {@const desc = meta.description ?? site.description}
  <meta name="description" content="{ desc }" />
  {#if meta.noindex}<meta name="robots" content="noindex" />{/if}

  <link rel="canonical" href="{ canonicalUrl }" />

  <meta property="og:title" content="{ htmlTitle }" />
  <meta property="og:site_name" content="{ site.title }" />
  <meta property="og:url" content="{ canonicalUrl }" />
  <meta property="og:type" content="website" />
  <meta property="og:description" content="{ desc }" />
  <meta property="og:image" content="{ ogImage }" />

  {@raw html.jsonLd}
</head>
